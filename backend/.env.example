PORT=8080
# Path to the SQLite file. Use :memory: for a throwaway database.
DATABASE_PATH=./data/wealthmate.db
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Comma separated list, or * to allow any origin
CORS_ORIGINS=*
# Seed the demo account automatically on an empty database
AUTO_SEED=true
